# The frame says how urgent a notification is: the accent, like the
# focused window's border, or red when critical.
[global]
    separator_color = frame
    highlight = "@ui_accent@"

[urgency_low]
    background = "@base@"
    foreground = "@subtext0@"
    frame_color = "@surface2@"

[urgency_normal]
    background = "@base@"
    foreground = "@text@"
    frame_color = "@ui_accent@"

[urgency_critical]
    background = "@base@"
    foreground = "@text@"
    frame_color = "@red@"
