#!/bin/sh
# fdwm-bar: dwm's status text. Volume, brightness, battery and the clock,
# redrawn every minute, at once when dwm's volume, mute and brightness keys
# run "fdwm-bar refresh", and at once when the volume changes anywhere else
# or a charger is plugged in or out (pactl and udevadm, see watch). At 10%
# battery it warns, in the bar and through dunst; at 3% it suspends the
# laptop.
#
#   fdwm-bar          run the bar (.xinitrc starts it)
#   fdwm-bar refresh  make the running bar redraw now
#   fdwm-bar print    print the status text once, without warning or
#                     suspending

sys=${FDWM_SYS:-/sys}  # the tests point this at a fake /sys
pidfile=${XDG_RUNTIME_DIR:-/tmp}/fdwm-bar-$(id -u).pid

# Called once each time the battery drops to 10% while discharging, with the
# level. The bar shows the warning either way; this pops it up through dunst
# too, as a critical notification, which stays until clicked. It prints the
# notification's id, for on_battery_back.
on_low_battery() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -p -a fdwm-bar -u critical "Battery at $1%" "Plug in: the laptop suspends at 3%."
}

# Called once the warning no longer applies (plugged in), with the level,
# the battery's status and on_low_battery's id: replaces the warning with a
# notification that goes after 3 seconds.
on_battery_back() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -r "$3" -a fdwm-bar -t 3000 "Battery at $1%" "$2"
}

# "Volume: 0.45" or "Volume: 0.45 [MUTED]" from wpctl
volume() {
    wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '
        { v = int($2 * 100 + 0.5) }
        /MUTED/ { printf "󰝟  %d%%", v; exit }
        { printf "%s  %d%%", v >= 60 ? "󰕾" : v >= 20 ? "󰖀" : "󰕿", v }'
}

brightness() {
    for d in "$sys"/class/backlight/*; do
        [ -r "$d/brightness" ] || continue
        read -r b <"$d/brightness"
        read -r m <"$d/max_brightness"
        [ "$m" -gt 0 ] && printf '󰃠  %d%%' $(((b * 100 + m / 2) / m))
        return
    done
}

# Sets $bat. Runs in the bar's own shell, not a subshell, because it
# remembers ($warned, $suspended) that it already warned or suspended for
# this discharge; each re-arms once the laptop charges or the level rises.
# $warned holds the warning notification's id, or "-" if there is none.
battery() {
    bat=
    for d in "$sys"/class/power_supply/BAT*; do
        [ -r "$d/capacity" ] || continue
        read -r cap <"$d/capacity"
        read -r state <"$d/status"
        if [ "$state" = Charging ]; then
            icon=󰂄
        else
            case $((cap / 10)) in
            0) icon=󰂎 ;; 1) icon=󰁺 ;; 2) icon=󰁻 ;; 3) icon=󰁼 ;; 4) icon=󰁽 ;;
            5) icon=󰁾 ;; 6) icon=󰁿 ;; 7) icon=󰂀 ;; 8) icon=󰂁 ;; 9) icon=󰂂 ;; *) icon=󰁹 ;;
            esac
        fi
        bat="$icon  $cap%"

        if [ "$state" = Discharging ] && [ "$cap" -le 10 ]; then
            bat="󰂃  $cap%  LOW BATTERY, PLUG IN"
            if [ -z "$warned" ]; then
                warned=$(on_low_battery "$cap")
                [ "$warned" ] || warned=-
            fi
        else
            [ "${warned:--}" != - ] && on_battery_back "$cap" "$state" "$warned"
            warned=
        fi
        if [ "$state" = Discharging ] && [ "$cap" -le 3 ]; then
            [ "$suspended" ] || { suspended=1; systemctl suspend; }
        else
            suspended=
        fi
        return
    done
}

# The events that change what the bar shows without dwm's keys, as pactl
# and udevadm report them (watch passes each line):
# sound: a sink's volume or mute changed, a sink came or went, or the default
# sink changed ("Event 'change' on sink #56", "Event 'change' on server #-1")
sound() { case $1 in *" on sink #"* | *" on server"*) ;; *) return 1 ;; esac; }
# power: a power supply changed: a charger plugged in or out, the battery's
# level or status ("UDEV  [1234.5678] change   /devices/.../AC (power_supply)",
# not the lines about what it monitors that it starts with, one of which
# also starts with UDEV)
power() { case $1 in UDEV*"(power_supply)") ;; *) return 1 ;; esac; }

# watch BAR FILTER COMMAND...: one watcher, which the bar starts in the
# background as "fdwm-bar watch": run COMMAND and redraw the bar (USR1, as
# "fdwm-bar refresh" does) at each line it prints that FILTER accepts. When
# COMMAND ends (PipeWire restarted, or isn't up yet), start it again after
# a pause: 2 s, doubling up to a minute while it keeps ending within 10 s of
# starting. COMMAND and the loop reading it are the watcher's children, and
# go with it: when the bar exits it stops the watcher (TERM), which stops
# them; if the bar is killed outright (kill -9), the watcher finds it gone at
# COMMAND's next event and stops too.
watch() {
    bar=$1 filter=$2
    shift 2
    trap 'pkill -P $$ 2>/dev/null; exit 0' HUP INT TERM
    delay=2
    while kill -0 "$bar" 2>/dev/null; do
        started=$(date +%s)
        # COMMAND's first line is its pid (sh -c prints it, then execs
        # COMMAND), so that the loop can stop it if the bar is gone: the wait
        # below is for both, and COMMAND may ignore the closed pipe (SIGPIPE)
        # shellcheck disable=SC2016  # $$ and $@ are the inner shell's
        sh -c 'echo $$; exec "$@"' sh "$@" 2>/dev/null | {
            read -r pid
            while read -r event; do
                "$filter" "$event" || continue
                kill -USR1 "$bar" 2>/dev/null && continue
                kill "$pid" 2>/dev/null
                exit 0
            done
        } &
        # (in the background and waited for, so that TERM is handled at once)
        wait $!
        kill -0 "$bar" 2>/dev/null || exit 0
        [ $(($(date +%s) - started)) -ge 10 ] && delay=2
        sleep "$delay" &
        wait $!
        delay=$((delay * 2 > 60 ? 60 : delay * 2))
    done
}

# Sets $line: the parts that exist, four spaces apart
draw() {
    battery
    line=
    for part in "$(volume)" "$(brightness)" "$bat" "$(date '+󰃭  %Y-%m-%d      %I:%M %p')"; do
        [ -n "$part" ] && line="$line${line:+    }$part"
    done
}

case ${1:-} in
refresh)
    [ -r "$pidfile" ] && kill -USR1 "$(cat "$pidfile")" 2>/dev/null
    exit 0
    ;;
print)
    warned=- suspended=1  # just print: never warn or suspend
    draw
    printf '%s\n' "$line"
    exit 0
    ;;
watch)  # (the bar's own watchers, see watch)
    shift
    watch "$@"
    exit 0
    ;;
"") ;;
*)
    echo "usage: fdwm-bar [refresh | print]" >&2
    exit 2
    ;;
esac

warned='' suspended='' again='' sleeper=''
echo $$ >"$pidfile"
# on exit (logging out, or killed with TERM, HUP or INT), take the children
# along: the watchers (which take theirs), and the sleep below
trap 'rm -f "$pidfile"; pkill -P $$ 2>/dev/null' EXIT
trap 'exit 0' HUP INT TERM
trap 'again=1' USR1
# the watchers (after the USR1 trap, so that a first redraw can't kill the
# bar), each skipped if its command isn't installed
if command -v pactl >/dev/null 2>&1; then
    "$0" watch $$ sound pactl subscribe &
fi
if command -v udevadm >/dev/null 2>&1; then
    "$0" watch $$ power udevadm monitor --udev --subsystem-match=power_supply &
fi
while :; do
    again=
    draw
    xsetroot -name "$line"
    [ "$again" ] && continue  # a refresh came in while drawing: draw again
    # sleep to the next minute in the background and wait for it, so a
    # refresh signal ends the wait at once
    sleep $((60 - $(date +%-S))) &
    sleeper=$!
    wait "$sleeper"
    kill "$sleeper" 2>/dev/null
    sleeper=
done
