# FDWM's colors, written down here and nowhere else. fdwm-theme generates
# the colors of dwm, st, dmenu, slock, the ttys, GRUB, dunst, Neovim, the
# prompt and the desktop from this file (see "Colors" in the README).
#
# One column per flavor, each color as rrggbb; a palette name in place of a
# color means that color, from the same column. The first column is the
# default. The names are Catppuccin's (https://catppuccin.com/palette),
# filled from the flavor's own colors:
#   thinkpad    a ThinkPad X1 Carbon's: soft black and charcoal, the silver
#               of its lettering for text, the TrackPoint's red for the
#               accent and the cursor, and muted colors for code, IBM's
#               blue among them

name          thinkpad
rosewater     d6c0b8
flamingo      d4948e
pink          d08aa0
mauve         d65a5a
red           e2231a
maroon        d9706a
peach         dd8a52
yellow        d6b064
green         8fb07a
teal          79ad9f
sky           8ab4c8
sapphire      6fa3bf
blue          7d9fd1
lavender      a8b0c8
text          c0c0c0
subtext1      a8a8a8
subtext0      929292
overlay2      7a7a7a
overlay1      636363
overlay0      4d4d4d
surface2      3a3a3a
surface1      2b2b2b
surface0      1f1f1f
base          141414
mantle        101010
crust         0b0b0b

# What the desktop draws with, so each flavor can pick its own: ui_text is
# the bar's and dmenu's text; ui_accent the selected tag's underline, the
# focused window's border, dmenu's selection, dunst's frame and the
# screenshot outline; ui_border the other windows' borders.
ui_text       subtext1
ui_accent     red
ui_border     surface1

# The bash prompt's: the git branch, then the directory and the $.
prompt_branch subtext0
prompt_dir    red

# The terminal's 16 colors (0-7 normal, 8-15 bright: black, red, green,
# yellow, blue, magenta, cyan, white), text, background and cursor: st uses
# all of them, and the ttys the 16, except that there 0 is the background
# and 7 the text. The ThinkPad's cursor is the TrackPoint's red.
term0         surface1
term1         red
term2         green
term3         yellow
term4         blue
term5         pink
term6         teal
term7         subtext1
term8         overlay1
term9         red
term10        green
term11        yellow
term12        blue
term13        pink
term14        teal
term15        text
term_fg       text
term_bg       base
term_cursor   red
