 	{ 0,                            XF86XK_AudioNext,          spawn,          SHCMD ("playerctl next")},
 	{ 0,                            XF86XK_AudioPrev,          spawn,          SHCMD ("playerctl previous")},
+	{ 0,                            XK_Print,                  spawn,          SHOT ("region")},
+	{ ShiftMask,                    XK_Print,                  spawn,          SHOT ("screen")},
 };
 
 /* button definitions */
diff --git a/dwm.1 b/dwm.1
index 6e5f0e7..77dc6ee 100644
--- a/dwm.1
+++ b/dwm.1
@@ -162,6 +162,15 @@ Raise or lower the volume by 5% (up to 100%), or toggle mute, with
 .B XF86AudioPlay, XF86AudioNext, XF86AudioPrev
 Play/pause, or skip to the next or previous track, with
 .BR playerctl (1).
+.TP
+.B Print
+Take a screenshot of a region you drag out with the mouse, with
+.BR maim (1):
+it is saved in ~/Pictures/Screenshots and copied to the clipboard.
+Escape or a right click cancels.
+.TP
+.B Shift\-Print
+The same for the whole screen.
 .SS Mouse commands
 .TP
 .B Mod1\-Button1
