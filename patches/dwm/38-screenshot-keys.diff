From FDWM commit c93d659 feat(dwm): Print and Shift+Print take screenshots

diff --git a/config.h b/config.h
index 2292afa..65f9d7a 100644
--- a/config.h
+++ b/config.h
@@ -58,6 +58,9 @@ static const Layout layouts[] = {
