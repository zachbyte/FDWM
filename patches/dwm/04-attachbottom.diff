 		(unsigned char *) &(c->win), 1);
@@ -1431,7 +1441,7 @@ sendmon(Client *c, Monitor *m)
 	detachstack(c);
 	c->mon = m;
 	c->tags = m->tagset[m->seltags]; /* assign tags of target monitor */
