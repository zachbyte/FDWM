 }
@@ -1108,18 +1109,10 @@ manage(Window w, XWindowAttributes *wa)
     c->mon->sel = c;
     arrange(c->mon);
 
-    if (c->isfloating) {
-        int newWidth = MIN_WINDOW_WIDTH;
-        int newHeight = MIN_WINDOW_HEIGHT;
-    
-        int newX = c->mon->mx + (c->mon->mw - newWidth) / 2;
