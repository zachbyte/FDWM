#!/usr/bin/env bash
# fdwm-theme: FDWM's colors, generated from the palette file next to it.
#
#   fdwm-theme generate      write the files below from the palette
#   fdwm-theme kernel-args   print the vt.default_* boot options that give
#                            the ttys the palette from boot (install.sh
#                            hands them to grubby)
#
# generate writes these; git ignores the ones in the repo, and edits to any
# of them are lost the next time it runs:
#   suckless/colors.h         dwm, st, dmenu and slock's colors
#   grub/theme/theme.txt      the GRUB theme, from grub/theme.txt.in
#   grub/theme/select_c.png   the bar behind GRUB's selected entry
#   ~/.config/fdwm/colors.sh  .bashrc's and .xinitrc's colors
set -euo pipefail

root=$(dirname "$(readlink -f "$0")")
conf=${XDG_CONFIG_HOME:-$HOME/.config}/fdwm
flavor=mocha

die() { echo "fdwm-theme: $*" >&2; exit 1; }

# load: the palette's $flavor column into color[<name>]=rrggbb, and the names
# in palette order into names; a name in place of a color is looked up
load() {
    local list name hex
    list=$(awk -v flavor="$flavor" '
        function ishex(s) { return s ~ /^[0-9a-f]+$/ && length(s) == 6 }
        function error(msg) { print "fdwm-theme: palette: " msg >"/dev/stderr"; failed = 1; exit 1 }
        /^[[:space:]]*(#|$)/ { next }
        $1 == "name" {
            for (i = 2; i <= NF; i++) if ($i == flavor) col = i
            if (!col) error("no " flavor " column")
            next
        }
        {
            if ($1 !~ /^[a-z][a-z0-9_]*$/) error("not a name: " $1)
            if ($1 in value) error($1 " is there twice")
            order[++n] = $1
            value[$1] = $col
        }
        END {
            if (failed) exit 1
            if (!col) error("no header line (name, then the flavors)")
            for (i = 1; i <= n; i++) {
                v = value[order[i]]
                if (!ishex(v)) v = value[v]
                if (!ishex(v)) error(order[i] ": neither a color nor a palette name: " value[order[i]])
                print order[i], v
            }
        }
    ' "$root/palette") || exit 1
    declare -gA color=()
    names=()
    while read -r name hex; do
        color[$name]=$hex
        names+=("$name")
    done <<<"$list"
    for name in term{0..15} term_fg term_bg term_cursor; do
        [[ -v color[$name] ]] || die "palette: $name is missing"
    done
}

# the ttys' 16 colors: term0-15, except that 0 is the background and 7 the
# text, which is what the Linux console draws plain text with
console() {
    local i
    for i in {0..15}; do
        case $i in
        0) echo "${color[term_bg]}" ;;
        7) echo "${color[term_fg]}" ;;
        *) echo "${color[term$i]}" ;;
        esac
    done
}

# the same 16 colors as the kernel's vt.default_red, _grn and _blu: one
# decimal list per channel
kernel_args() {
    local tty=() channel=(red grn blu) args=() i c list
    mapfile -t tty < <(console)
    for i in 0 1 2; do
        list=
        for c in "${tty[@]}"; do list+=,$((16#${c:i*2:2})); done
        args+=("vt.default_${channel[i]}=${list#,}")
    done
    echo "${args[*]}"
}

# bytes N...: the bytes N... as printf %b escapes
bytes() { printf '\\0%03o' "$@"; }

# chunk TYPE DATA: a PNG chunk (length, type, DATA, CRC-32 of type and
# DATA), DATA as printf %b escapes. gzip ends its output with that same
# CRC-32, least significant byte first.
chunk() {
    local len c0 c1 c2 c3
    len=$(printf '%b' "$2" | wc -c)
    read -r c0 c1 c2 c3 <<<"$(printf '%b' "$1$2" | gzip -c | tail -c 8 | od -An -tu1 -N4)"
    printf '%b' "$(bytes $((len >> 24 & 255)) $((len >> 16 & 255)) $((len >> 8 & 255)) $((len & 255)))"
    printf '%b' "$1$2$(bytes "$c3" "$c2" "$c1" "$c0")"
}

# png RRGGBB: a PNG of one pixel in that color (GRUB stretches it). The
# pixel's row is filter 0, red, green, blue, in a zlib stream that stores
# it as is: header, one uncompressed block of 4 bytes, Adler-32.
png() {
    local r=$((16#${1:0:2})) g=$((16#${1:2:2})) b=$((16#${1:4:2}))
    local s1=$((1 + r + g + b)) s2=$((4 + 3 * r + 2 * g + b))  # Adler-32's two sums
    printf '%b' "$(bytes 137 80 78 71 13 10 26 10)"
    chunk IHDR "$(bytes 0 0 0 1 0 0 0 1 8 2 0 0 0)"  # 1x1, 8-bit RGB
    chunk IDAT "$(bytes 120 1 1 4 0 251 255 0 "$r" "$g" "$b" \
        $((s2 >> 8)) $((s2 & 255)) $((s1 >> 8)) $((s1 & 255)))"
    chunk IEND ''
}

# write FILE: stdin into FILE, replacing it only once all of it is written
write() {
    mkdir -p "$(dirname "$1")"
    cat >"$1.tmp"
    mv -f "$1.tmp" "$1"
}

generate() {
    local name theme left sed_args=() tty=()
    {
        echo "/* Generated by fdwm-theme from the palette file ($flavor); edits here are"
        echo " * lost. config.h in dwm, st, dmenu and slock includes it. */"
        for name in "${names[@]}"; do
            printf '#define COL_%s "#%s"\n' "${name^^}" "${color[$name]}"
        done
    } | write "$root/suckless/colors.h"

    # grub/theme.txt.in with every @<name>@ replaced by that color
    for name in "${names[@]}"; do
        sed_args+=(-e "s/@$name@/#${color[$name]}/g")
    done
    theme=$(sed "${sed_args[@]}" "$root/grub/theme.txt.in")
    left=$(grep -o '@[a-z0-9_]*@' <<<"$theme" | sort -u | tr '\n' ' ') || true
    [[ -z $left ]] || die "grub/theme.txt.in: not in the palette: $left"
    {
        echo "# Generated by fdwm-theme from grub/theme.txt.in and the palette file"
        echo "# ($flavor); edits here are lost."
        printf '%s\n' "$theme"
    } | write "$root/grub/theme/theme.txt"
    # the bar behind the selected entry, in surface0 like the images it
    # replaced (select_*.png in theme.txt.in)
    png "${color[surface0]}" | write "$root/grub/theme/select_c.png"

    mapfile -t tty < <(console)
    {
        echo "# Generated by fdwm-theme from FDWM's palette file ($flavor); edits here"
        echo "# are lost. .bashrc and .xinitrc read it."
        for name in "${names[@]}"; do
            printf "fdwm_%s='#%s'\n" "$name" "${color[$name]}"
        done
        echo "# the ttys' 16 colors, for .bashrc"
        printf "fdwm_console='%s'\n" "${tty[*]}"
    } | write "$conf/colors.sh"

    echo "Generated the $flavor colors: suckless/colors.h, the GRUB theme and $conf/colors.sh"
}

case ${1:-} in
generate) load; generate ;;
kernel-args) load; kernel_args ;;
*)
    echo "usage: fdwm-theme generate | kernel-args" >&2
    exit 2
    ;;
esac
